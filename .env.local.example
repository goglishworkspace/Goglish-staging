# قيم البيئة المحلية بتطلع من `npx supabase start` (انسخهم من الـ output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# رابط الموقع الأساسي - يُستخدم في app/sitemap.ts وapp/robots.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# مفتاح 32-byte (64 hex char) لتشفير الرقم القومي بـ AES-256-GCM
# يتولّد بـ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NATIONAL_ID_ENCRYPTION_KEY=

# Bunny Stream (Section 7) - لسه مفيش حساب فعلي، القيم دي placeholders بس
# عشان BunnyVideoProvider يشتغل محلياً (راجع lib/video/bunny.provider.ts).
# لما يبقى فيه حساب حقيقي: حط library id والـ Token Authentication key الحقيقيين هنا.
BUNNY_LIBRARY_ID=000000
BUNNY_TOKEN_AUTH_KEY=local-dev-placeholder-key

# Payments (Section 9) - لسه مفيش حسابات دفع حقيقية. Stripe مفتاح حقيقي
# التوثيق بتاعه موثوق (راجع lib/payments/stripe.provider.ts)؛ باقي البوابات
# Stubs (راجع lib/payments/stub.provider.ts).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# لازم true عشان الـ stub providers فوق تشتغل - في production بيتجاهل تماماً
# (راجع lib/payments/index.ts).
ENABLE_MOCK_PAYMENTS=true

PAYMOB_HMAC_SECRET=
VODAFONE_CASH_HMAC_SECRET=
INSTAPAY_HMAC_SECRET=

# Kashier (Section 9) - real integration, see lib/payments/kashier.provider.ts.
# KASHER_HMAC_SECRET is the "Payment API Key" from Kashier dashboard ->
# Developers -> Integrations (signs checkout hashes + webhook signatures).
# KASHER_SECRET_KEY is the separate Secret Key (server-to-server auth).
# KASHER_MODE is "test" or "live".
KASHER_MERCHANT_ID=
KASHER_HMAC_SECRET=
KASHER_SECRET_KEY=
KASHER_MODE=test

# اختياري - البروفايدر الافتراضي لزرار "اشترك" في صفحة الكورس العامة
# (app/(marketing)/courses/[id]/page.tsx). لو مش متحدد بيستخدم stripe.
NEXT_PUBLIC_DEFAULT_PAYMENT_PROVIDER=

# نسبة ضريبة القيمة المضافة المصرية الافتراضية.
TAX_RATE_PERCENT=14

# نفس القيمة المستخدمة في supabase/migrations/20260727110010_reconciliation_cron.sql
# كـ fallback محلي (لازم تتطابق مع بعض).
RECONCILE_SECRET=

# نفس القيمة المستخدمة في supabase/migrations/20260730140008_user_hard_delete_cron.sql
# كـ fallback محلي (لازم تتطابق مع بعض).
USER_HARD_DELETE_SECRET=
